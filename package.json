{
  "name": "slot-machine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "preview:https": "npm run build && vite preview --host --mode https",
    "icons": "node scripts/make-icons.mjs",
    "check": "node scripts/check.ts",
    "simulate": "node scripts/simulate.ts --spins 10000000",
    "tune": "node scripts/tune.ts",
    "paytable": "node scripts/paytable.ts",
    "build:pages": "VITE_BASE=/${REPO:-slot-game}/ npm run build",
    "regress": "node scripts/regress.ts",
    "tune:gilt": "node scripts/tune-gilt.ts",
    "verify:gilt": "node scripts/verify-gilt.ts",
    "rebalance": "node scripts/rebalance.ts",
    "tiers": "node scripts/tiers.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "idb": "^8.0.3"
  }
}
